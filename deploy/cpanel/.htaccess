# SocialMedia IA — cPanel / LiteSpeed / Apache
#
# Coloque este arquivo em ~/public_html/edijalmemoura/socialai/.htaccess
# (junto de app.cgi e do projeto).
#
# Ele faz o endereço abaixo entregar a APLICAÇÃO em vez do 403 de "diretório
# sem índice". Modo CGI: não precisa de "Setup Python App" (Passenger).
#
#   https://projetoredesnordeste.com.br/edijalmemoura/socialai/
#      → redireciona para …/socialai/install → tela de instalação
#
# IMPORTANTE: se `Options +ExecCGI` ou o rewrite não valerem nesta pasta, a
# hospedagem pode exigir que você libere CGI no diretório pai (ou abra ticket).

# ---------------------------------------------------------------------------
# 1. Nada de listagem de diretório e app.cgi como índice (mata o 403)
# ---------------------------------------------------------------------------
Options -Indexes
DirectoryIndex app.cgi

# ---------------------------------------------------------------------------
# 2. CGI habilitado para o app.cgi
# ---------------------------------------------------------------------------
<IfModule mod_cgi.c>
    Options +ExecCGI
    AddHandler cgi-script .cgi
</IfModule>
<IfModule mod_cgid.c>
    AddHandler cgi-script .cgi
</IfModule>

# ---------------------------------------------------------------------------
# 3. Roteamento: tudo entra no app.cgi preservando o caminho
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # RewriteBase relativo: NÃO fixe "/edijalmemoura/socialai/" aqui. A regra
    # abaixo funciona subindo do arquivo até a raiz do site, então o mesmo
    # .htaccess serve em qualquer pasta, domínio ou subdomínio.
    RewriteBase /

    # Bloqueios de segurança vêm ANTES do roteamento.
    RewriteRule (^|/)(dados|instance|tests|docs|deploy|backups)(/|$) - [F,L]
    RewriteRule (^|/)\.(git|env|htaccess|gitignore) - [F,L]
    RewriteRule \.(py|pyc|pyo|env|db|sqlite|sqlite3|log|bak|md|ini|cfg|yaml|yml)$ - [F,L]
    RewriteRule (^|/)(requirements\.txt|component_map\.py|passenger_wsgi\.py|docker-compose\.yml|compose\.yaml)$ - [F,L]

    # Arquivos e pastas reais (static/, uploads públicos) continuam sendo
    # servidos pelo servidor web — mais rápido e sem passar pelo CGI.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Todo o resto é da aplicação: /install, /dashboard, /login, /api/...
    RewriteRule ^(.*)$ app.cgi/$1 [L,QSA]
</IfModule>

# ---------------------------------------------------------------------------
# 4. Sem mod_rewrite: a raiz da pasta ainda deixa de dar 403
# ---------------------------------------------------------------------------
<Files "app.cgi">
    <IfModule mod_cgi.c>
        SetHandler cgi-script
    </IfModule>
</Files>

# ---------------------------------------------------------------------------
# 5. Cabeçalhos básicos (a aplicação também envia os seus)
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---------------------------------------------------------------------------
# 6. Cinto e suspensório: nada de .env/senhas servidos por engano
# ---------------------------------------------------------------------------
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>
<FilesMatch "\.(py|db|sqlite3?|log|env)$">
    Require all denied
</FilesMatch>
