# Dados da instância: banco SQLite, segredos e rascunhos do instalador.
# Nada aqui pode ser baixado pelo navegador. O código não depende deste
# arquivo (data/ fica acima de public/), ele é a segunda barreira.
#
# Apache 2.4 (cPanel atual)
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
# Apache 2.2 (cPanel antigo)
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

Options -Indexes
