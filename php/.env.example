# Configuração da instância PHP (copie para .env). NUNCA versione o .env real.
# Precedência: variável de ambiente do servidor > .env > data/installer.env

# Subpasta pública onde a aplicação está montada (sem barra no fim).
SOCIALMEDIA_BASE_PATH=/edijalmemoura/socialai
SOCIALMEDIA_PUBLIC_ORIGIN=https://projetoredesnordeste.com.br/edijalmemoura/socialai

# Segredos. SECRET_KEY pode ficar VAZIO: o instalador gera e grava um em
# data/installer.env (0600) na primeira instalação. Se preferir definir aqui,
# gere com: php -r "echo bin2hex(random_bytes(32));"
# Nunca troque um SECRET_KEY já usado: ele assina as URLs de mídia da Meta.
SECRET_KEY=
# Protege /install. Sem esta variável, qualquer pessoa com a URL pode instalar
# até a conta ser criada (a própria tela avisa disso).
SOCIALMEDIA_INSTALL_TOKEN=

# 1 = cookies só via HTTPS
COOKIE_SECURE=1

# Onde ficam SQLite, rascunhos e installer.env (padrão: php/data)
# SOCIALMEDIA_DATA=/home/USUARIO/socialai/php/data

# IA (opcional). Sem chave, Planejamento e Estúdio criam rascunho local — o
# produto nunca finge que houve IA. OPENAI_ENDPOINT só é necessário para Azure/proxy.
#
# CHAVE: use uma chave de *service account* (prefixo sk-svcacct-), com
# permissão "Restricted" e um projeto só para este produto. Chave de usuário
# (sk-proj-) deixa de funcionar quando a pessoa sai do projeto, e chave de
# admin (sk-admin-) não serve para chamar modelo.
# OPENAI_API_KEY=
#
# MODELOS: modelo desligado pela OpenAI derruba a geração inteira (HTTP 404).
# Se aparecer esse erro, troque estas duas linhas — não é preciso mexer no código.
# OPENAI_MODEL=gpt-6-luna
# OPENAI_ENDPOINT=
# OPENAI_IMAGE_MODEL=gpt-image-2
#
# --- Meta (Facebook/Instagram) ---
# Sem estas chaves o módulo falha fechado: a tela diz o que falta e NADA é
# enviado à Meta. Nenhum token é exibido em tela, log ou mensagem de erro.
# App em https://developers.facebook.com/apps/
# META_APP_ID=
# META_APP_SECRET=
# META_GRAPH_VERSION=v23.0
# Precisa ser HTTPS e terminar em /integrations/meta/callback — com a subpasta:
# META_REDIRECT_URI=https://projetoredesnordeste.com.br/edijalmemoura/socialai/integrations/meta/callback
# Chave que cifra os tokens das Páginas (AES-256-GCM). NUNCA troque depois de
# conectar: os tokens guardados ficam ilegíveis e é preciso reconectar.
# Gere com: php -r "echo base64_encode(random_bytes(32));"
# META_TOKEN_ENCRYPTION_KEY=
# Origem HTTPS de onde a Meta baixa as artes. Opcional quando
# SOCIALMEDIA_PUBLIC_ORIGIN já é o endereço público correto.
# META_PUBLIC_BASE_URL=https://projetoredesnordeste.com.br/edijalmemoura/socialai
# Só para testes locais (servidor Graph simulado). Em produção, deixe vazio:
# aponta o produto para um host que não é a Meta.
# META_GRAPH_ENDPOINT=
