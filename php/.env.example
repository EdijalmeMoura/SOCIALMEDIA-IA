# Configuração da instância PHP (copie para .env). NUNCA versione o .env real.
# Precedência: variável de ambiente do servidor > .env > data/installer.env

# Subpasta pública onde a aplicação está montada (sem barra no fim).
SOCIALMEDIA_BASE_PATH=/edijalmemoura/socialai
SOCIALMEDIA_PUBLIC_ORIGIN=https://projetoredesnordeste.com.br/edijalmemoura/socialai

# Segredos (gere com: php -r "echo bin2hex(random_bytes(32));")
SECRET_KEY=
SOCIALMEDIA_INSTALL_TOKEN=

# 1 = cookies só via HTTPS
COOKIE_SECURE=1

# Onde ficam SQLite, rascunhos e installer.env (padrão: php/data)
# SOCIALMEDIA_DATA=/home/USUARIO/socialai/php/data

# Opcionais
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_IMAGE_MODEL=gpt-image-1
# META_APP_ID=
# META_APP_SECRET=
# META_GRAPH_VERSION=v23.0
